<?xml version="1.0"?>
<configuration>
<startup>
  <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1"/>
</startup>

  <appSettings>
    <add key="OTPLink_Login" value=""/>
    <add key="OTPLink_Forgot" value=""/>
	<add key="IVROTPLink" value=""/>
    <add key="BseCurrDeriv" value="false"/>
  </appSettings>
  
  <system.serviceModel>
        <bindings>
            <wsHttpBinding>
                <binding name="WSHttpBinding_MFOrderEntry">
                    <security mode="None"/>
                </binding>
                <binding name="WSHttpBinding_MFOrderEntry1">
                    <security mode="Transport">
                        <transport clientCredentialType="None"/>
                    </security>
                </binding>
                <binding name="WSHttpBinding_IMFUploadService">
                    <security mode="None"/>
                </binding>
                <binding name="WSHttpBinding_IMFUploadService1">
                    <security mode="Transport">
                        <transport clientCredentialType="None"/>
                    </security>
                </binding>
            </wsHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://pbustarmfsrv113.bseltd.domain:81/MFOrderEntry/MFOrder.svc" binding="wsHttpBinding" bindingConfiguration="WSHttpBinding_MFOrderEntry" contract="ServiceReference1.MFOrderEntry" name="WSHttpBinding_MFOrderEntry"/>
            <endpoint address="https://bsestarmfdemo.bseindia.com/MFOrderEntry/MFOrder.svc/Secure" binding="wsHttpBinding" bindingConfiguration="WSHttpBinding_MFOrderEntry1" contract="ServiceReference1.MFOrderEntry" name="WSHttpBinding_MFOrderEntry1"/>
            <endpoint address="http://pbustarmfsrv113.bseltd.domain:81/MFUploadService/MFUploadService.svc/Basic" binding="wsHttpBinding" bindingConfiguration="WSHttpBinding_IMFUploadService" contract="ServiceReference2.IMFUploadService" name="WSHttpBinding_IMFUploadService"/>
            <endpoint address="https://bsestarmfdemo.bseindia.com/MFUploadService/MFUploadService.svc/Secure" binding="wsHttpBinding" bindingConfiguration="WSHttpBinding_IMFUploadService1" contract="ServiceReference2.IMFUploadService" name="WSHttpBinding_IMFUploadService1"/>
        </client>
    </system.serviceModel>
</configuration>
